{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": {
      "@coop/shared": ["packages/shared/src/index.ts"],
      "@coop/shared/*": ["packages/shared/src/*"]
    },
    "outDir": "dist",
    "rootDir": "..",
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "config.ts", "../shared/src/sync-config.ts"]
}

  "decisions": [
    {
      "id": "D1",
      "choice": "Create a new feature pack instead of reopening ux-surface-clarity",
      "rationale": "ux-surface-clarity is effectively a completed product-surface simplification pack; modern CSS adoption needs a separate architecture and primitive-tracking lane."
    },
    {
      "id": "D2",
      "choice": "Keep API and contracts n/a",
      "rationale": "The planned work is CSS, UI primitives, validation, and durable guidance only."
    },
    {
      "id": "D3",
      "choice": "Treat overscroll gestures and HTML-in-Canvas as research-only",
      "rationale": "They are not mature cross-browser primitives for Coop's production UI yet."
    },
    {
      "id": "D4",
      "choice": "Record Chrome platform proof requirements before runtime work",
      "rationale": "Coop's extension and local-first surfaces need explicit CWV, isolated DevTools MCP, and frozen WebMCP approval evidence before any future prototype is promoted."
    }
  ],
  "updated_at": "2026-05-24"
